# Single-origin front door: the SPA and the API answer as one origin, the same
# property Vite's dev proxy gives locally (vite.config.ts) and the reason Phase
# 5 rejected a split origin (10-phase5-plan.md §3.1) — the auth cookie is
# SameSite=Lax and is not sent on a cross-site request.
#
# {$DOMAIN} and {$BACKEND_ADDR} are supplied by docker-compose.prod.yml, not
# hardcoded here — the same image runs behind any domain or any backend service
# name without a rebuild.
{$DOMAIN} {
	# Proxied before the file server, and stripped of its prefix on the way
	# through — the backend's routes are mounted at the root (main.py), not
	# under /api, matching the dev proxy's rewrite exactly.
	handle_path /api/* {
		# lb_try_duration is what makes a rolling deploy (deploy/compose's
		# docker-compose.prod.yml, swapped one service at a time via
		# .github/workflows/deploy.yml) not drop requests. Without it, Caddy's
		# default is a single attempt — a request that lands in the window
		# where the backend container has stopped and its replacement hasn't
		# passed its healthcheck yet gets an immediate 502, not a retry. This
		# was measured, not assumed: the first version of this file shipped
		# without it, and a real rolling swap produced ~2.7s of consecutive
		# 502s. With it, the same swap keeps retrying the single upstream for
		# up to 15s — comfortably longer than a container recreate plus
		# healthcheck — so a request in that window waits briefly instead of
		# failing. There is only one upstream here, so this is not
		# load-balancing; it is retry-until-it-answers.
		reverse_proxy {$BACKEND_ADDR} {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Grafana dashboards (deploy/compose/docker-compose.observability.yml).
	# Public on purpose — reuses this same TLS listener/certificate, and
	# Grafana's own login is the actual auth boundary, generated the same way
	# SECRET_KEY is (provision.sh). Prometheus and Loki, which have no login
	# of their own, are deliberately NOT proxied here — see
	# docker-compose.observability.yml's comments on both.
	#
	# Plain `handle`, not `handle_path`: unlike /api/* below, Grafana is
	# configured with GF_SERVER_SERVE_FROM_SUB_PATH=true and already expects
	# to see the /grafana prefix itself — stripping it here would have Caddy
	# forward /login while Grafana is only listening for /grafana/login.
	handle /grafana/* {
		reverse_proxy grafana:3000 {
			lb_try_duration 15s
			lb_try_interval 250ms
		}
	}

	# Everything else is the built SPA. try_files falls back to index.html for
	# any path that is not a real static asset, which is what a client-side
	# router (react-router-dom) needs — a deep link like /projects/abc must
	# still resolve to the app shell, not a 404 from the file server.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
		encode gzip
	}
}
