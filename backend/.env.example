# Copy to .env for local development. Every value below is also the built-in
# default, so an empty .env (or none at all) still starts the app.

# development | production
ENVIRONMENT=development

# Enables FastAPI's debug mode. Leave off unless you need the traceback page.
DEBUG=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Matches the credentials in docker-compose.yml. The +asyncpg driver suffix is
# required — without it SQLAlchemy loads a sync driver and every query fails.
DATABASE_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops

# Job queue. The API publishes scan jobs here; the worker consumes them.
REDIS_URL=redis://localhost:6379/0

# Repository cloning. Every scan clones into a disposable directory under
# CLONE_ROOT, which is removed afterwards whether or not the scan succeeded.
# The limits bound what one arbitrary repository can cost the worker.
CLONE_ROOT=repos
CLONE_TIMEOUT_SECONDS=120
CLONE_MAX_BYTES=500000000
CLONE_MAX_FILES=50000

# Signs the JWT auth cookie. The default below is in the repository and is
# therefore public — the app refuses to start with it when ENVIRONMENT=production,
# where it must be at least 32 bytes of real randomness. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# How long a login lasts. There is no refresh flow, so this is the full session.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Rate limiting on the auth endpoints, per client IP.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
SIGNUP_RATE_LIMIT=5/minute

# In-process counters. Fine for one replica; with more than one, each keeps its
# own tally and the effective limit becomes N times this. Point it at Redis when
# running more than one:
#   RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
RATE_LIMIT_STORAGE_URI=memory://
