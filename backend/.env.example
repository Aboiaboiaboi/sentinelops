# Copy to .env for local development. Every value below is also the built-in
# default, so an empty .env (or none at all) still starts the app.

# development | production
ENVIRONMENT=development

# Enables FastAPI's debug mode. Leave off unless you need the traceback page.
DEBUG=false

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Matches the credentials in docker-compose.yml. The +asyncpg driver suffix is
# required — without it SQLAlchemy loads a sync driver and every query fails.
DATABASE_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops

# Job queue. The API publishes scan jobs here; the worker consumes them.
REDIS_URL=redis://localhost:6379/0

# Where generated reports are written in development. Gitignored.
STORAGE_DIR=reports

# The bucket reports are written to when deployed. Leave empty locally: empty
# means "use STORAGE_DIR", and a bucket wins over it when both are set.
#
# A bucket name, nothing else. No project, no region, no key — the service
# account or instance role attached to the process supplies the credentials, so
# there is nothing here to keep secret.
#
# Setting this is not optional on a real deployment. STORAGE_DIR there writes to
# the container filesystem, which is per-instance and discarded on redeploy or
# at scale-to-zero, so the report cache would not error — it would quietly
# re-render on every replica and lose everything on the way down.
STORAGE_BUCKET=

# Which class owns STORAGE_BUCKET: "gcs" or "s3". Defaults to gcs, so an
# existing deployment that only ever set STORAGE_BUCKET keeps behaving exactly
# as before this setting existed. "gcs" requires the optional `gcs` dependency
# group; "s3" requires `s3` — the Dockerfile installs both, a bare `uv sync`
# installs neither.
STORAGE_PROVIDER=gcs

# S3 only. Empty selects real AWS. Set to point the same S3Storage class at
# anything else that speaks the S3 API — Cloudflare R2, DigitalOcean Spaces,
# MinIO, even GCS's own interop endpoint — which is the entire cost of moving
# object storage off AWS. Example for a local MinIO:
#   STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ENDPOINT_URL=

# S3 only. Empty lets boto3 resolve a region the usual way (environment, shared
# config, instance metadata). Most S3-compatible providers ignore this — MinIO
# does — but AWS itself requires one for some operations.
STORAGE_REGION=

# Repository cloning. Every scan clones into a disposable directory under
# CLONE_ROOT, which is removed afterwards whether or not the scan succeeded.
# The limits bound what one arbitrary repository can cost the worker.
CLONE_ROOT=repos
CLONE_TIMEOUT_SECONDS=120
CLONE_MAX_BYTES=500000000
CLONE_MAX_FILES=50000

# Container isolation for the security tools, which run third-party binaries
# against an untrusted repository. Off by default — with no sandbox those
# checks report as errored rather than running unisolated.
#
# The worker never touches Docker itself any more — it asks a separate,
# host-level scan broker (backend/app/broker/, started by systemd, never by
# Compose) to run one of five fixed tool images over a narrow Unix socket.
# SANDBOX_BROKER_SOCKET is where that socket is mounted into this container;
# the volume names, per-tool memory/timeout ceilings, and concurrency limit
# that used to live here now live in the broker's own systemd unit
# (deploy/compose/sentinelops-broker.service) — this process no longer needs
# to know any of them. See deploy/compose/provision.sh / provision-dev.sh to
# set the broker up.
SANDBOX_ENABLED=false
SANDBOX_BROKER_SOCKET=/run/sentinelops-broker.sock

# Only consulted when the browser talks to the API cross-origin. Local dev goes
# through the frontend's /api proxy, which is same-origin, so CORS never enters
# the picture there.
CORS_ORIGINS=["http://localhost:5173"]

# Signs the JWT auth cookie. The default below is in the repository and is
# therefore public — the app refuses to start with it when ENVIRONMENT=production,
# where it must be at least 32 bytes of real randomness. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# How long a login lasts. There is no refresh flow, so this is the full session.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# GitHub App for private repositories. Optional — leave these empty and public
# repositories work with no GitHub account at all. Create the App under GitHub
# Settings -> Developer settings -> GitHub Apps with ONLY
# Repository -> Contents: Read-only, and webhooks off. Then paste the Client ID,
# the App's URL slug (the last segment of github.com/apps/<slug>), and the
# base64 of the downloaded .pem:
#   python -c "import base64,sys;print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())" app.pem
#
# The key can mint access to every installed user's repositories: in production
# it must come from a secret manager, never a committed file. Installation
# tokens minted from it expire in an hour and are never persisted.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_SLUG=

# Where GitHub's post-install redirect sends the browser back to.
FRONTEND_URL=http://localhost:5173

# Rate limiting, per client IP. The auth endpoints are limited because they are
# what an attacker grinds against; the report endpoint because rendering a PDF
# is the most expensive GET in the API and opening a tab repeatedly reaches it.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
SIGNUP_RATE_LIMIT=5/minute
REPORT_RATE_LIMIT=20/minute

# In-process counters. Fine for one replica; with more than one, each keeps its
# own tally and the effective limit becomes N times this. Point it at Redis when
# running more than one:
#   RATE_LIMIT_STORAGE_URI=redis://redis:6379/1
RATE_LIMIT_STORAGE_URI=memory://
