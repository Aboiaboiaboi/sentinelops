# Copy to .env and fill in. provision.sh does this for you and generates
# SECRET_KEY and POSTGRES_PASSWORD itself — hand-editing is only needed for the
# values only you know: the domain and the storage bucket.

# A domain you control, pointed at this VM's IP with an A record before you
# run docker compose up. Caddy requests a Let's Encrypt certificate for exactly
# this name on first start and will fail closed without working DNS — there is
# no IP-only fallback, because cookie_secure requires HTTPS (app/config.py) and
# a self-signed certificate would just move the failure to the browser.
DOMAIN=

# Generate with: openssl rand -base64 48
# Same validation backend/app/config.py applies in production: at least 32
# bytes, and never the repository's DEV_SECRET_KEY.
SECRET_KEY=

POSTGRES_USER=sentinelops
POSTGRES_DB=sentinelops
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Object storage. S3Storage (backend/app/utils/storage.py) speaks the S3 API,
# which is most clouds at once: AWS S3, Cloudflare R2, DigitalOcean Spaces,
# MinIO, or GCS through its interop endpoint. Set STORAGE_PROVIDER=gcs instead
# to use GcsStorage, and leave STORAGE_ENDPOINT_URL empty either way unless
# you're pointing at something other than real AWS/GCS.
STORAGE_PROVIDER=s3
STORAGE_BUCKET=
# Empty for real AWS S3. Set for anything else — e.g. R2:
#   STORAGE_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
# S3 credentials. Leave both empty on AWS if the VM has an instance role that
# already grants bucket access — boto3 finds it without these. Required for
# R2, Spaces, MinIO and any account without an attached role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# GitHub App, for private-repository access. Optional — leave all three empty
# and the feature reports itself as unconfigured; public repositories still
# work. See backend/.env.example for how GITHUB_APP_PRIVATE_KEY_B64 is encoded.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_SLUG=

# How many sandboxed tool containers the worker runs at once. 6 was measured
# against a developer's Docker Desktop VM (10-phase5-plan.md and
# docker-compose.yml both explain the arithmetic); a cheap cloud VM with 1–2 GB
# of RAM should likely run lower. Leave unset to keep the default.
SANDBOX_MAX_CONCURRENT=

# Grafana's admin login, for /grafana on the deployment domain
# (docker-compose.observability.yml). Not optional the way GITHUB_APP_* is —
# Grafana refuses to start without one. provision.sh generates this the same
# way it generates SECRET_KEY/POSTGRES_PASSWORD; set by hand only if running
# the observability stack outside provision.sh. Generate with:
#   openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=

# A second, read-only Grafana login (username "viewer") that provision.sh
# creates automatically once Grafana is up — safe to hand out to anyone you
# want to show a dashboard to, without giving out the admin password.
# Generated the same way as GRAFANA_ADMIN_PASSWORD; same generate-by-hand
# fallback if running the stack outside provision.sh.
GRAFANA_VIEWER_PASSWORD=
