# Environment / secrets
.env
.env.*
!.env.example

# Python (backend, worker)
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node (frontend)
node_modules/
dist/
.vite/
*.local
*.tsbuildinfo
coverage/

# Editors / OS / local tooling
.claude/
.vscode/
.idea/

# Local working notes and design docs — not part of the repo
Handoff files/
handoff/
notes/
*.local.md
.DS_Store
Thumbs.db

# Runtime artifacts
# Note: gitignore has no inline comments — a '#' only starts one at the
# beginning of a line, so a trailing comment becomes part of the pattern and
# silently matches nothing.
*.log
/tmp/

# Repositories cloned for scanning — untrusted third-party code
repos/

# Generated PDF reports
reports/

# Terraform. The provider directory is hundreds of megabytes of downloaded
# binary; the lock file next to it is NOT ignored, because it pins the provider
# hashes and is the reason two people get the same plan.
deploy/.terraform/
# State never belongs in git: it holds every generated password in plain text,
# and two people committing it produces a merge conflict that no longer
# describes any real infrastructure. It lives in the bucket bootstrap.sh makes.
*.tfstate
*.tfstate.*
# Names one particular deployment, and backend.hcl points at its state bucket.
deploy/terraform.tfvars
deploy/backend.hcl
# `terraform plan` output saved to a file for review. Useful in the moment,
# stale the moment the config or the real infrastructure changes again — the
# same reason .tfstate is ignored, one step removed.
deploy/*.out
plan*.out
crash.log

# Portfolio screenshots, generated on demand against a mocked API — not a
# build artifact the application needs, and not something the repository gains
# by tracking. Left on disk; just kept out of `git status`.
/screenshots/
