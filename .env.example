# Read by `docker compose up` at the repository root (docker-compose.yml),
# the same way deploy/compose/.env.example is read there. Everything the dev
# stack needs already has a working default baked into docker-compose.yml —
# this file exists only for the one thing that doesn't: the GitHub App.

# Optional. Leave all three empty and docker-compose.yml behaves exactly as
# it does with no .env at all — public repositories work, private ones
# report themselves unavailable (a 503 from GET /api/github/install) rather
# than half-working. Full setup instructions, including where each of these
# three values comes from, are in backend/.env.example next to the same
# variables — this file only exists because Compose does not read a
# container's own .env into it automatically, and copying the explanation
# twice would be the kind of documentation that drifts.
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_B64=
GITHUB_APP_SLUG=
